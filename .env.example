# Copy this file to .env before starting Docker Compose.
# Values below are safe development placeholders only. Change them for every non-local environment.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://helpdesk:replace-with-a-local-development-password@db:5432/helpdesk?schema=public
JWT_SECRET=replace-with-a-long-random-secret-for-local-development
PORT=4000
FRONTEND_URL=http://localhost:5173
